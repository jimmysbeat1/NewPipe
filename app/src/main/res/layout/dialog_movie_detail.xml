<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/moviePoster"
                android:layout_width="92dp"
                android:layout_height="138dp"
                android:background="@drawable/bg_thumbnail_rounded"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                android:src="@drawable/placeholder_thumbnail_video" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/movieTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="?android:attr/textAppearanceLarge"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    tools:text="Dune: Part Two" />

                <TextView
                    android:id="@+id/movieFacts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textAppearance="?android:attr/textAppearanceSmall"
                    android:textSize="14sp"
                    tools:text="2024 • ★ 8.1 • 2 h 47 min" />

                <TextView
                    android:id="@+id/movieGenres"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textAppearance="?android:attr/textAppearanceSmall"
                    android:textSize="14sp"
                    android:visibility="gone"
                    tools:text="Science Fiction, Adventure"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/movieBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_duration_badge"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:textColor="@color/duration_text_color"
                    android:textSize="12sp"
                    tools:text="@string/discover_access_ads" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/movieOverview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:lineSpacingMultiplier="1.15"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textSize="14sp"
            tools:text="Paul Atreides unites with the Fremen while on a warpath of revenge." />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/discover_detail_where"
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/movieOffers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:lineSpacingMultiplier="1.2"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textIsSelectable="true"
            android:textSize="14sp"
            tools:text="Free with ads: Tubi TV\nSubscription: Netflix\nRent: Apple TV" />

        <Button
            android:id="@+id/movieWatch"
            style="@style/Widget.AppCompat.Button.Colored"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:minHeight="48dp"
            android:textAllCaps="false"
            android:visibility="gone"
            tools:text="Watch free with ads on Tubi TV"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/movieWatchNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textSize="12sp"
            android:visibility="gone"
            tools:text="@string/discover_watch_note_page"
            tools:visibility="visible" />

        <Button
            android:id="@+id/movieLocal"
            style="@style/Widget.AppCompat.Button.Colored"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:minHeight="48dp"
            android:textAllCaps="false"
            android:visibility="gone"
            tools:text="@string/discover_local_film" />

        <Button
            android:id="@+id/movieTrailer"
            style="@style/Widget.AppCompat.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:minHeight="48dp"
            android:text="@string/discover_trailer"
            android:textAllCaps="false"
            android:visibility="gone"
            tools:visibility="visible" />

        <Button
            android:id="@+id/movieWatchlist"
            style="@style/Widget.AppCompat.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/movies_watchlist_add"
            android:textAllCaps="false" />

        <TextView
            android:id="@+id/movieDownloadNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/discover_download_note"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/movieChecked"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textSize="12sp"
            tools:text="Film information from TMDB. Where-to-watch data from JustWatch, checked 17 Nov 2026." />

        <Button
            android:id="@+id/movieTmdb"
            style="@style/Widget.AppCompat.Button.Borderless.Colored"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="-8dp"
            android:minHeight="48dp"
            android:text="@string/discover_view_tmdb"
            android:textAllCaps="false" />
    </LinearLayout>
</ScrollView>
